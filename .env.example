# =========================================
# ESTOQUE MOBILE - Configuração de Ambiente
# =========================================
# Copie este arquivo para ".env" e preencha
# os valores antes de iniciar o servidor.
# =========================================

# ---- SERVIDOR ----
PORT=3001

# ---- AUTENTICAÇÃO (JWT) ----
# Chave secreta para assinar os tokens JWT.
# Use uma string longa e aleatória em produção!
# Gere uma com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_longa_e_aleatoria

# ---- INTELIGÊNCIA ARTIFICIAL ----

# Ativar/Desativar chamadas à API de IA externa.
# false = usa parser heurístico local (funciona 100% offline, sem custo).
# true  = usa a API configurada abaixo (requer chave com faturamento ativo).
IA_ENABLED=false

# Provedor de IA: gemini | openai | groq
IA_PROVIDER=gemini

# Chave da API do provedor escolhido.
# Gemini:  https://aistudio.google.com/apikey
# OpenAI:  https://platform.openai.com/api-keys
# Groq:    https://console.groq.com/keys
IA_API_KEY=sua_chave_api_aqui

# Modelo a ser utilizado pelo provedor.
# Gemini: gemini-flash-latest | gemini-2.0-flash | gemini-2.5-flash
# OpenAI: gpt-4o-mini | gpt-3.5-turbo
# Groq:   llama3-8b-8192 | llama3-70b-8192
IA_MODEL=gemini-flash-latest
